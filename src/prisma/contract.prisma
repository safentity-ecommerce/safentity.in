model User {
  id        String            @id @default(uuid())
  phone     String?           @unique
  name      String?
  email     String?           @unique
  password  String?           @map("password_hash")
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  @@map("users")
}

model OtpChallenge {
  id        String            @id @default(uuid())
  phone     String
  codeHash  String
  attempts  Int               @default(0)
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())

  @@map("otp_challenges")
}